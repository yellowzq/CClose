// CClose application icon resource.
// assets/app.ico is the placeholder icon (generated by assets/make_icon.py,
// concept A). Replace assets/app.ico with your own icon file and rebuild.
2 ICON "app.ico"

// Version resource. Numeric literals are used for the OS/type fields so the
// resource compiles with Zig's bundled llvm-rc (no SDK headers needed).
// Give the exe legitimate product metadata: unsigned Zig-built hooking apps
// are a common target for AV machine-learning false positives, and a proper
// VERSIONINFO block helps push those heuristics below their threshold.
// Keep the version here in sync with the GitHub release tag.
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,1,0
PRODUCTVERSION 0,1,1,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "yellowzq"
            VALUE "FileDescription", "CClose - Windows window management tool"
            VALUE "FileVersion", "0.1.1"
            VALUE "InternalName", "CClose"
            VALUE "LegalCopyright", "Copyright (c) 2026 yellowzq"
            VALUE "OriginalFilename", "CClose.exe"
            VALUE "ProductName", "CClose"
            VALUE "ProductVersion", "0.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04b0
    END
END
